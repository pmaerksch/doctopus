{
	"name": "pmaerksch/doctopus",
	"description": "Symfony bundle for portable, database-agnostic Doctrine migrations across MySQL, MariaDB and SQLite.",
	"type": "symfony-bundle",
	"license": "MIT",
	"keywords": ["symfony", "bundle", "doctrine", "migrations", "dbal", "mysql", "mariadb", "sqlite", "portable"],
	"authors": [
		{
			"name": "Philip Märksch",
			"email": "maerksch@software-und-meer.de"
		}
	],
	"require": {
		"php": ">=8.2",
		"doctrine/dbal": "^3.8 || ^4.0",
		"doctrine/doctrine-bundle": "^2.11",
		"doctrine/doctrine-migrations-bundle": "^3.3",
		"doctrine/migrations": "^3.7",
		"symfony/config": "^6.4 || ^7.0",
		"symfony/console": "^6.4 || ^7.0",
		"symfony/dependency-injection": "^6.4 || ^7.0",
		"symfony/http-kernel": "^6.4 || ^7.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5",
		"symfony/framework-bundle": "^6.4 || ^7.0",
		"symfony/yaml": "^6.4 || ^7.0"
	},
	"autoload": {
		"psr-4": {
			"Doctopus\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Doctopus\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
